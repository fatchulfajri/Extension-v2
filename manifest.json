{
  "manifest_version": 3,
  "name": "Claim Analytic System for Enhancement",
  "version": "1.0.0",
  "description": "AI-powered SOAP documentation assistant with real-time correction",
  "icons": {
    "16": "assets/case_logo.png",
    "48": "assets/case_logo.png",
    "128": "assets/case_logo.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "src/core/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "css": ["src/content/styles/floating-button.css", "src/content/styles/sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/case_logo.png",
      "48": "assets/case_logo.png",
      "128": "assets/case_logo.png"
    }
  }
}
